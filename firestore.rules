rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Public read-only product catalogs (e.g., rolls, sushi, sets, etc.)
    match /{collectionName}/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Users collection
    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();

      // Favorites under a user
      match /favorites/{productId} {
        allow read, write: if isOwner(uid);
      }

      // Orders under a user
      match /orders/{orderId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if isOwner(uid) || isAdmin();
      }

      // Addresses under a user
      match /addresses/{addressId} {
        allow read, write: if isOwner(uid);
      }
    }

    // Top-level orders (if used by backend/webhooks only)
    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Cities and zones read-only for clients
    match /cities/{cityId} {
      allow read: if true;
      allow write: if isAdmin();
      match /zones/{zoneId} {
        allow read: if true;
        allow write: if isAdmin();
      }
    }

    // Settings (min order, fees, etc.) managed by admins
    match /settings/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}